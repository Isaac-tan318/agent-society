# --- Secrets ---------------------------------------------------------------
# Holds the LLM API key. A fresh clone gets one from the Studio's
# "LLM settings" page (or by hand, see RUN.md).
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
# The venv also holds the patched agentsociety2 sources (see RUN.md,
# "What was done to make v2 run on Windows").
.venv/
__pycache__/
*.py[cod]

# --- Local tool settings --------------------------------------------------------
.claude/settings.local.json

# --- Simulation output (regenerated by running an experiment) ------------------
# Each run writes its log, agent memories, replay traces and, for mobility
# studies, the downloaded routing binary into its own folder.
/run/
/experiment/run/
paper_experiments/**/runs/
paper_experiments/.studio_logs/
agentsociety_data/

# Paper-study configs are rebuilt from init/config_params.py on every run and
# contain absolute local paths. Experiments built in the Studio
# (paper_experiments/my_experiments/) have no generator, so theirs stay tracked.
paper_experiments/hypothesis_*/**/init/init_config.json
paper_experiments/hypothesis_*/**/init/steps.yaml

# --- Downloaded datasets and maps (large; see RUN.md for where to get them) ---
*.pb
*.pb.cache
data/cache/
paper_experiments/data/
paper_experiments/hypothesis_3_psych_survey/data/qi2025/

# --- Singapore / v1 configs -----------------------------------------------------
config/singapore.yaml
config/ui.yaml

# --- OS ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
